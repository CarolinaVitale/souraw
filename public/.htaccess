# /public_html/souraw/.htaccess
RewriteEngine On

# La página /schedule ya no existe: los links viejos (Instagram, favoritos) van a /orders.
RewriteRule ^schedule/?$ /orders [R=301,L]

# Sirve archivos y carpetas reales
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Todo lo demás → index.html del build (SPA)
RewriteRule . index.html [L]